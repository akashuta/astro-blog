---
import { person } from "~/lib/seo/person";
import { t } from "~/i18n";
import { getLocaleFromPath } from "~/lib/i18n/routing";

const locale = getLocaleFromPath(Astro.url.pathname);
const aboutHref = locale === "en" ? "/en/about/" : "/about/";
const projectsHref = locale === "en" ? "/en/projects/" : "/projects/";
---

<aside class="author-card" aria-label={t(locale, "authorCard.aboutLabel")}>
  <a href={aboutHref} class="author-card__avatar-link" aria-hidden="true" tabindex="-1">
    <picture>
      <source
        type="image/avif"
        srcset="/avatar-64.avif 64w, /avatar-128.avif 128w, /avatar-288.avif 288w"
        sizes="(max-width: 600px) 48px, 56px"
      />
      <source
        type="image/webp"
        srcset="/avatar-64.webp 64w, /avatar-128.webp 128w, /avatar-288.webp 288w"
        sizes="(max-width: 600px) 48px, 56px"
      />
      <img
        src="/avatar-128.webp"
        alt=""
        width="56"
        height="56"
        class="author-card__avatar"
        loading="lazy"
        decoding="async"
      />
    </picture>
  </a>
  <div class="author-card__body">
    <p class="author-card__label">{t(locale, "authorCard.aboutLabel")}</p>
    <p class="author-card__name"><a href={aboutHref}>{person.name}</a></p>
    <p class="author-card__role">{t(locale, "authorCard.role")}</p>
    <ul class="author-card__links">
      <li><a href={aboutHref}>{t(locale, "authorCard.viewProfile")}</a></li>
      <li><a href={projectsHref}>{t(locale, "authorCard.viewProjects")}</a></li>
    </ul>
  </div>
</aside>

<style>
  /* Poster pass: a framed slab, not a tinted panel. The old 1px border on a
     raised background read as a light patch between the article and the ink
     footer; the frame and the offset shadow give it an edge instead. It stays
     on paper rather than inverting, because the footer right below it is
     already a solid ink block. */
  .author-card {
    position: relative;
    display: grid;
    grid-template-columns: 56px 1fr;
    gap: var(--space-4);
    align-items: start;
    padding: var(--space-6) var(--space-5) var(--space-5);
    margin: var(--space-8) 0 0 0;
    border: var(--stroke-slab) solid var(--color-fg);
    border-radius: var(--radius-md);
    background: var(--color-bg-elevated);
    box-shadow: var(--shadow-soft);
  }
  .author-card__avatar-link {
    line-height: 0;
  }
  .author-card__avatar {
    width: 56px;
    height: 56px;
    border-radius: var(--radius-pill);
    border: var(--stroke-bold) solid var(--color-fg);
    background: var(--color-bg);
    object-fit: cover;
  }
  .author-card__body {
    display: grid;
    gap: var(--space-1);
  }
  /* The label is a tab notched into the top edge, the same move the TL;DR
     slab uses, so the two read as one family. */
  .author-card__label {
    position: absolute;
    top: 0;
    left: var(--space-4);
    transform: translateY(-50%);
    background: var(--color-fill);
    color: var(--color-on-fill);
    padding: 3px 10px;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    margin: 0;
  }
  .author-card__name {
    font-family: var(--font-serif);
    font-size: var(--fs-xl);
    font-weight: 800;
    letter-spacing: var(--tracking-tight);
    text-transform: uppercase;
    margin: 0;
  }
  .author-card__name a {
    color: var(--color-fg);
    text-decoration: none;
    border-bottom: var(--stroke-slab) solid transparent;
  }
  .author-card__name a:hover {
    border-bottom-color: var(--color-fill);
  }
  .author-card__role {
    color: var(--color-fg-muted);
    font-size: var(--fs-sm);
    margin: 0 0 var(--space-2) 0;
  }
  .author-card__links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    font-size: var(--fs-sm);
  }
  .author-card__links a {
    color: var(--color-accent);
    font-weight: 600;
    text-decoration-thickness: var(--stroke-bold);
    text-underline-offset: 4px;
  }
  @media (max-width: 600px) {
    .author-card {
      grid-template-columns: 1fr;
      padding: var(--space-6) var(--space-4) var(--space-4);
      gap: var(--space-3);
    }
    .author-card__avatar-link {
      width: 48px;
      height: 48px;
    }
    .author-card__avatar {
      width: 48px;
      height: 48px;
    }
  }
</style>
