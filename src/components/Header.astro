---
/**
 * Site header — Poster redesign.
 *
 * Changes from the editorial version:
 *   - Wordmark set in the display face, uppercase, with a registered mark
 *   - Nav labels uppercase in the label face at --tracking-wide
 *   - Active and hovered links carry a 4px lime underline that grows in
 *   - Flat solid background: no translucency, no backdrop blur
 *   - Search and drawer controls are square, 2px ink, invert on hover
 *
 * Untouched: i18n routing, drawer trigger, search dispatch, aria contracts.
 */
import LangToggle from "./LangToggle.astro";
import ThemeToggle from "./ThemeToggle.astro";
import { t } from "~/i18n";
import { getLocaleFromPath } from "~/lib/i18n/routing";

const { pathname } = Astro.url;
const locale = getLocaleFromPath(pathname);

// For active-state matching, compare against the locale-stripped path so /en/blog still matches /blog
const localPath = locale === "en" ? pathname.replace(/^\/en/, "") || "/" : pathname;
const isActive = (prefix: string): boolean =>
  prefix === "/" ? localPath === "/" : localPath.startsWith(prefix);

const homeHref = locale === "en" ? "/en/" : "/";
const blogHref = locale === "en" ? "/en/blog/" : "/blog/";
const aboutHref = locale === "en" ? "/en/about/" : "/about/";
const nowHref = locale === "en" ? "/en/now/" : "/now/";
const usesHref = locale === "en" ? "/en/uses/" : "/uses/";
const projectsHref = locale === "en" ? "/en/projects/" : "/projects/";

const tagline = locale === "en" ? "notes from production" : "записки из продакшна";
---

<header class="site-header" role="banner" data-site-header>
  <div class="site-header__inner">
    <a
      href={homeHref}
      class="site-header__brand"
      aria-label={`artka.dev — ${tagline} — ${t(locale, "nav.home")}`}
    >
      <span class="site-header__lockup">artka.dev<sup aria-hidden="true">&#174;</sup></span>
      <span class="site-header__tagline">{tagline}</span>
    </a>

    <nav class="site-header__nav" aria-label={t(locale, "nav.primary")}>
      <a href={blogHref} aria-current={isActive("/blog") ? "page" : undefined}
        >{t(locale, "nav.posts")}</a
      >
      <a href={aboutHref} aria-current={isActive("/about") ? "page" : undefined}
        >{t(locale, "nav.about")}</a
      >
      <a href={nowHref} aria-current={isActive("/now") ? "page" : undefined}
        >{t(locale, "nav.now")}</a
      >
      <a href={usesHref} aria-current={isActive("/uses") ? "page" : undefined}
        >{t(locale, "nav.uses")}</a
      >
      <a href={projectsHref} aria-current={isActive("/projects") ? "page" : undefined}
        >{t(locale, "nav.projects")}</a
      >
    </nav>

    <div class="site-header__actions">
      <LangToggle />
      <ThemeToggle />
      <button
        type="button"
        class="site-header__search"
        aria-label={t(locale, "nav.search") + " (⌘K)"}
        onclick="window.dispatchEvent(new CustomEvent('search:open'))"
      >
        <span class="site-header__search-key" aria-hidden="true">⌘K</span>
        <svg
          class="site-header__search-icon"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          aria-hidden="true"
        >
          <circle cx="11" cy="11" r="6.5" stroke="currentColor" stroke-width="2.25"></circle>
          <path d="M16 16l4.5 4.5" stroke="currentColor" stroke-width="2.25" stroke-linecap="round"
          ></path>
        </svg>
        <span class="visually-hidden">{t(locale, "nav.search")}</span>
      </button>
    </div>

    <button
      type="button"
      class="site-header__drawer-btn"
      aria-label={t(locale, "drawer.openAria")}
      aria-controls="site-drawer"
      aria-expanded="false"
      data-drawer-trigger
      onclick="window.dispatchEvent(new CustomEvent('mobile-drawer:toggle'))"
    >
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path
          d="M4 6h16M4 12h16M4 18h16"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"></path>
      </svg>
    </button>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--color-bg);
    border-bottom: var(--stroke-hair) solid var(--color-border);
    transition: border-color var(--dur-fast) var(--ease-out);
  }
  /* Scrolled state darkens the rule to ink instead of adding thickness,
     which would shift every page by a pixel on first scroll. */
  .site-header[data-scrolled] {
    border-bottom-color: var(--color-fg);
  }
  .site-header__inner {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: var(--space-4) var(--space-5);
    display: flex;
    align-items: center;
    gap: var(--space-5);
  }

  /* ── Lockup ─────────────────────────────────────────────── */
  .site-header__brand {
    display: inline-flex;
    flex-direction: column;
    line-height: 1;
    text-decoration: none;
    color: var(--color-fg);
  }
  .site-header__lockup {
    font-family: var(--font-serif);
    font-size: var(--fs-lg);
    font-weight: 800;
    letter-spacing: var(--tracking-tight);
    text-transform: uppercase;
  }
  .site-header__lockup sup {
    font-size: 0.42em;
    font-weight: 700;
    vertical-align: super;
    letter-spacing: 0;
  }
  .site-header__tagline {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--color-fg-subtle);
    margin-top: var(--space-2);
  }

  /* ── Nav ───────────────────────────────────────────────── */
  .site-header__nav {
    margin-left: auto;
    display: flex;
    gap: var(--space-5);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
  }
  .site-header__nav a {
    position: relative;
    color: var(--color-fg-muted);
    text-decoration: none;
    padding-bottom: var(--space-2);
    transition: color var(--dur-fast) var(--ease-out);
  }
  /* The underline is a pseudo-element rather than text-decoration so it can
     grow from the left; 4px is the slab stroke the whole system draws with. */
  .site-header__nav a::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: 0;
    width: 0;
    height: var(--stroke-slab);
    background: var(--color-fill);
    transition: width var(--dur-fast) var(--ease-out);
  }
  .site-header__nav a:hover {
    color: var(--color-fg);
  }
  .site-header__nav a:hover::after {
    width: 100%;
  }
  .site-header__nav a[aria-current="page"] {
    color: var(--color-fg);
  }
  .site-header__nav a[aria-current="page"]::after {
    width: 100%;
  }

  /* ── Actions cluster ───────────────────────────────────── */
  .site-header__actions {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
  }

  .site-header__drawer-btn {
    display: none;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    margin-inline-start: var(--space-2);
    background: transparent;
    border: var(--stroke-bold) solid var(--color-fg);
    border-radius: var(--radius-md);
    padding: var(--space-2);
    color: var(--color-fg);
    cursor: pointer;
    transition:
      background var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }
  .site-header__drawer-btn:hover {
    background: var(--color-fill);
    color: var(--color-on-fill);
  }

  /* The control shows a glyph at rest and the shortcut on hover. Both faces
     are stacked in the same box, so the swap never reflows the row — which
     matters, because this row is width-critical down to 320px. */
  .site-header__search {
    position: relative;
    width: 44px;
    height: 34px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    font-weight: 700;
    letter-spacing: var(--tracking-wide);
    border: var(--stroke-bold) solid var(--color-fg);
    border-radius: var(--radius-md);
    background: transparent;
    color: var(--color-fg);
    cursor: pointer;
    line-height: 1.2;
    transition:
      background var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out),
      box-shadow var(--dur-fast) var(--ease-out),
      transform var(--dur-fast) var(--ease-out);
  }
  .site-header__search-key,
  .site-header__search-icon {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: opacity var(--dur-fast) var(--ease-out);
  }
  .site-header__search-key {
    opacity: 0;
  }
  .site-header__search-icon {
    opacity: 1;
  }
  /* No hover on touch, so the glyph is what a phone keeps. */
  @media (hover: hover) {
    .site-header__search:hover .site-header__search-key,
    .site-header__search:focus-visible .site-header__search-key {
      opacity: 1;
    }
    .site-header__search:hover .site-header__search-icon,
    .site-header__search:focus-visible .site-header__search-icon {
      opacity: 0;
    }
  }
  .site-header__search:hover {
    background: var(--color-fill);
    color: var(--color-on-fill);
    transform: translate(-2px, -2px);
    box-shadow: var(--shadow-press);
  }
  .site-header__search:active {
    transform: none;
    box-shadow: none;
  }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 1023px) {
    .site-header__drawer-btn {
      display: inline-flex;
    }
    .site-header__nav {
      display: none;
    }
    .site-header__actions {
      margin-inline-start: auto;
    }
  }
  /* Keep the menu separate from the compact utility controls. */
  @media (max-width: 767px) {
    .site-header__inner {
      padding: var(--space-3) var(--space-4);
      gap: var(--space-2);
    }
    .site-header__lockup {
      font-size: var(--fs-base);
    }
    .site-header__tagline {
      display: none;
    }
    .site-header__actions {
      gap: var(--space-2);
    }
    /* The drawer button owes the cluster 16px of clear air (asserted in
       tests/unit/seo/site-shell-browser.test.ts); space-2 was not enough
       once the controls grew a 2px border. */
    .site-header__drawer-btn {
      margin-inline-start: var(--space-4);
    }
  }

  /* 320px is the floor the shell is tested at, and the row has to fit there
     with a 15px scrollbar taken out of it. Unbounded is a wide face and every
     control gained a 2px border in the poster pass, so width is reclaimed in
     three steps below: search becomes a glyph at 767, the wordmark drops a
     size and loses its ® at 414, and the language control moves to the drawer
     at 360. The theme toggle and, down to 375, the language toggle stay in
     the header, because tests/unit/seo/site-shell-browser.test.ts clicks both
     there at that width. */
  @media (max-width: 767px) {
    .site-header__search {
      width: 40px;
      height: 40px;
    }
  }

  @media (max-width: 414px) {
    .site-header__lockup {
      font-size: var(--fs-sm);
    }
    /* The registered mark is 6px the row cannot spare at this width. */
    .site-header__lockup sup {
      display: none;
    }
    .site-header__actions {
      gap: var(--space-1);
    }
  }

  /* Below 360px the language control leaves the header. It is not lost: the
     drawer footer carries the same LangToggle, and the shell test clicks the
     header one at 375px, which keeps it. */
  @media (max-width: 360px) {
    .site-header__actions :global(.lang-toggle) {
      display: none;
    }
  }

  /* Last-resort net: if a longer wordmark or a wider face ever overruns the
     row, the brand clips instead of the document scrolling sideways. */
  .site-header__brand {
    min-width: 0;
  }
  .site-header__lockup {
    white-space: nowrap;
    overflow: hidden;
  }
</style>

<script>
  function initHeaderScroll(): void {
    const header = document.querySelector<HTMLElement>("[data-site-header]");
    if (!header || header.dataset.scrollBound === "1") return;
    header.dataset.scrollBound = "1";

    const sync = (): void => {
      if (window.scrollY > 4) {
        header.setAttribute("data-scrolled", "");
      } else {
        header.removeAttribute("data-scrolled");
      }
    };
    sync();
    window.addEventListener("scroll", sync, { passive: true });
  }

  document.addEventListener("astro:page-load", initHeaderScroll);
</script>
