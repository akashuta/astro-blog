---
/**
 * Phase 5 audit fix — REPLACEMENT for src/layouts/BaseLayout.astro.
 *
 * Diff vs. previous (everything else identical):
 *   1. Description default: "Personal blog" → richer fallback that won't
 *      show on real pages (every page sets its own) but is sane in case.
 *   2. Favicon: SVG light + SVG dark via media query, .ico legacy
 *      fallback, apple-touch-icon as PNG (was incorrectly pointing at
 *      .svg — Safari iOS doesn't support svg apple-touch-icon).
 *   3. theme-color: light + dark variants via media-query <meta>.
 *   4. <link rel="manifest" href="/site.webmanifest"> for PWA install.
 *   5. <link rel="mask-icon"> for Safari pinned tabs.
 *   6. og:image fallback: PNG version of og-default if the request is
 *      from a known SVG-hostile crawler (Twitter cards historically
 *      didn't render SVG well — we ship both, prefer PNG via og:image
 *      and keep SVG as og:image:secure).
 *
 * The fonts/maskable PNG referenced here are documented in
 * docs/assets/FAVICON-RASTER-README.md — generate them locally
 * from the shipped SVGs before deploying.
 */
import "~/styles/global.css";
import { ClientRouter } from "astro:transitions";
import Header from "~/components/Header.astro";
import MobileDrawer from "~/components/MobileDrawer.astro";
import SkipLink from "~/components/SkipLink.astro";
import Search from "~/components/Search.astro";
import WebMCP from "~/components/WebMCP.astro";
import Analytics from "~/components/Analytics.astro";
import { t, type StringKey } from "~/i18n";
import { getLocaleFromPath, getCounterpart, checkCounterpartExists } from "~/lib/i18n/routing";
import { buildGraph, safeJsonLd, type GraphNode } from "~/lib/seo/schema";
import { person } from "~/lib/seo/person";
import { canonicalPath, canonicalUrl } from "~/lib/seo/url-policy";
import { twitterHandleFromSameAs } from "~/lib/seo/social";
import { brandedTitle } from "~/lib/seo/title";
// Hashed URLs of the display-face subsets. Vite dedupes by content, so these
// resolve to the exact files @fontsource's CSS references — preloading them
// takes the H1 web-font off the CSS critical path. Latin + Cyrillic only:
// the other subsets (vietnamese, *-ext) are never used above the fold.
// scripts/verify-seo-build.ts asserts each href below appears verbatim in an
// emitted CSS file, so these must stay in step with src/styles/fonts.css.
import displayLatinUrl from "@fontsource-variable/unbounded/files/unbounded-latin-wght-normal.woff2?url";
import displayCyrillicUrl from "@fontsource-variable/unbounded/files/unbounded-cyrillic-wght-normal.woff2?url";

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogImageAlt?: string | undefined;
  ogImageWidth?: number | undefined;
  ogImageHeight?: number | undefined;
  ogType?: "website" | "article";
  noindex?: boolean;
  fullWidth?: boolean;
  /** Drop the left sidebar column entirely (home page editorial layout). */
  noSidebar?: boolean;
  extraSchemaNodes?: ReadonlyArray<GraphNode | null>;
  /**
   * Third-party origins the page fetches a first-screen asset from (an
   * off-site cover image, for example). Absolute http(s) origins only;
   * anything else — and this site's own origin — is ignored.
   */
  preconnect?: ReadonlyArray<string>;
}

const {
  title,
  description = "Записки из продакшна — backend, AI agent engineering, distributed systems.",
  ogImage,
  ogImageAlt,
  ogImageWidth,
  ogImageHeight,
  ogType = "website",
  noindex = false,
  fullWidth = false,
  noSidebar = false,
  extraSchemaNodes = [],
  preconnect = [],
} = Astro.props;

// Origins worth a handshake before the markup that needs them is parsed.
// Only absolute http(s) URLs survive, reduced to their origin and deduped;
// our own origin is dropped because the document itself already opened it.
const selfOrigin = (Astro.site ?? Astro.url).origin;
const preconnectOrigins = [
  ...new Set(
    preconnect.flatMap((value) => {
      let parsed: URL;
      try {
        parsed = new URL(value);
      } catch {
        return [];
      }
      if (parsed.protocol !== "https:" && parsed.protocol !== "http:") return [];
      return parsed.origin === selfOrigin ? [] : [parsed.origin];
    }),
  ),
];

// Brand suffix within the ~60-character SERP budget — rule and rationale in
// src/lib/seo/title.ts. Pages don't have to remember to append it themselves.
const fullTitle = brandedTitle(title);
// Only <title> gets the suffixed form. og:title and twitter:title below take
// the bare title: og:site_name already states the brand on the card, and a
// second copy of it only eats the part of the headline that says something.

const locale = getLocaleFromPath(Astro.url.pathname);
const canonical = canonicalUrl(Astro.url.pathname);

const counterpartPath = getCounterpart(Astro.url.pathname, locale);
const counterpartExists = await checkCounterpartExists(Astro.url.pathname, locale);
const ruVariant = locale === "ru" ? canonical : canonicalUrl(counterpartPath);
const enVariant = locale === "en" ? canonical : canonicalUrl(counterpartPath);

// An hreflang cluster is a claim that both addresses are the same page, open
// to indexing. A noindexed member makes the whole cluster look broken, and a
// 404 (the runtime not-found route renders this layout too) would invite the
// crawler to check a second address that also does not exist. Either way the
// alternates are withheld — counterpartExists alone is not enough.
const indexableCluster = !noindex && Astro.response.status !== 404;
const showAlternates = counterpartExists && indexableCluster;

const ogLocale = locale === "ru" ? "ru_RU" : "en_US";
const ogLocaleAlternate = locale === "ru" ? "en_US" : "ru_RU";

// OG image: always PNG raster. SVG fallback used to live on og:image:secure_url
// but Twitter/Facebook reject SVG previews — see SEO audit 2026-05-08, claim #10.
const absoluteOgImage = ogImage
  ? /^https?:\/\//.test(ogImage)
    ? ogImage
    : new URL(ogImage, Astro.site ?? Astro.url).toString()
  : new URL("/og-default.png", Astro.site ?? Astro.url).toString();

// Explicit env override wins; otherwise derive the handle from the X profile
// listed in person.sameAs so cards attribute correctly without extra config.
const twitterHandle =
  import.meta.env.PUBLIC_TWITTER_HANDLE || twitterHandleFromSameAs(person.sameAs) || undefined;
const imageAlt = ogImageAlt ?? fullTitle;
// Preload only the subsets this locale paints first: Cyrillic for RU pages,
// Latin for both (brand, code, EN copy).
const fontPreloads = locale === "ru" ? [displayCyrillicUrl, displayLatinUrl] : [displayLatinUrl];
const rssHref = locale === "ru" ? "/rss.xml" : "/en/rss.xml";
const jsonFeedHref = locale === "ru" ? "/feed.json" : "/en/feed.json";

const localePrefix = locale === "en" ? "/en" : "";

interface FooterLink {
  readonly href: string;
  readonly key: StringKey;
  /** `"false"` opts the link out of prefetching; `undefined` drops the attribute. */
  readonly prefetch: "false" | undefined;
}

// ClientRouter only ever navigates to an HTML document, so prefetching a feed,
// a sitemap or any other file spends bytes on a navigation that can never
// happen (rss.xml + feed.json alone are ~47 KB). `trailingSlash: "always"`
// means every real page path ends in "/", so a file extension on the last
// segment is what marks a link as a non-HTML resource.
const isDocumentHref = (href: string): boolean => !/\.[a-z0-9]+$/i.test(href);

const footerLink = (href: string, key: StringKey): FooterLink => ({
  href,
  key,
  prefetch: isDocumentHref(href) ? undefined : "false",
});

const footerLinks = {
  about: [
    footerLink(canonicalPath(`${localePrefix}/about`), "nav.about"),
    footerLink(canonicalPath(`${localePrefix}/contact`), "nav.contact"),
    footerLink(canonicalPath(`${localePrefix}/privacy`), "nav.privacy"),
    footerLink(canonicalPath(`${localePrefix}/now`), "nav.now"),
    footerLink(canonicalPath(`${localePrefix}/uses`), "nav.uses"),
    footerLink(canonicalPath(`${localePrefix}/projects`), "nav.projects"),
  ],
  read: [
    footerLink(canonicalPath(`${localePrefix}/blog`), "nav.posts"),
    footerLink(canonicalPath(`${localePrefix}/tags`), "footer.link.tags"),
    footerLink(rssHref, "footer.link.rss"),
    footerLink(jsonFeedHref, "footer.link.json"),
  ],
} as const;

const socialLabel = (url: string): string => {
  const host = new URL(url).hostname.replace(/^www\./, "");
  if (host.endsWith("github.com")) return "GitHub";
  if (host.endsWith("linkedin.com")) return "LinkedIn";
  if (host === "x.com" || host === "twitter.com") return "X";
  if (host === "t.me" || host === "telegram.me") return "Telegram";
  if (host.includes("mastodon")) return "Mastodon";
  return host;
};
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {
      preconnectOrigins.map((origin) => (
        <>
          <link rel="preconnect" href={origin} crossorigin />
          <link rel="dns-prefetch" href={origin} />
        </>
      ))
    }
    {
      fontPreloads.map((href) => (
        <link rel="preload" as="font" type="font/woff2" href={href} crossorigin="anonymous" />
      ))
    }
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem("artka-theme");
          var prefersDark =
            window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches;
          var theme = stored || (prefersDark ? "dark" : "paper");
          if (theme === "dark") {
            document.documentElement.setAttribute("data-theme", "dark");
          }
        } catch (e) {
          /* localStorage blocked */
        }
      })();
    </script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {/* Indexable pages opt in to large image previews (Google Discover, image search). */}
    <meta name="robots" content={noindex ? "noindex,follow" : "max-image-preview:large"} />
    <link rel="canonical" href={canonical} />
    {
      showAlternates && (
        <>
          <link rel="alternate" hreflang="ru" href={ruVariant} />
          <link rel="alternate" hreflang="en" href={enVariant} />
          <link rel="alternate" hreflang="x-default" href={ruVariant} />
        </>
      )
    }

    <!-- Open Graph / Twitter -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content={ogLocale} />
    {counterpartExists && <meta property="og:locale:alternate" content={ogLocaleAlternate} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="artka.dev" />
    <meta property="og:image" content={absoluteOgImage} />
    <meta property="og:image:width" content={String(ogImageWidth ?? 1200)} />
    <meta property="og:image:height" content={String(ogImageHeight ?? 630)} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteOgImage} />
    <meta name="twitter:image:alt" content={imageAlt} />
    {twitterHandle && <meta name="twitter:site" content={twitterHandle} />}
    {twitterHandle && <meta name="twitter:creator" content={twitterHandle} />}

    <!-- Favicon set -->
    <link
      rel="icon"
      type="image/svg+xml"
      href="/favicon.svg"
      media="(prefers-color-scheme: light)"
    />
    <link
      rel="icon"
      type="image/svg+xml"
      href="/favicon-dark.svg"
      media="(prefers-color-scheme: dark)"
    />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" href="/icon-32.png" sizes="32x32" />
    <link rel="icon" type="image/png" href="/icon-16.png" sizes="16x16" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="mask-icon" href="/favicon.svg" color="#2A1AE0" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- theme-color: split light/dark so iOS Safari address bar matches -->
    <meta name="theme-color" content="#F3F1EA" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0B0B0B" media="(prefers-color-scheme: dark)" />

    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={t(locale, "site.feedTitle")}
      href={rssHref}
    />
    <link
      rel="alternate"
      type="application/feed+json"
      title={t(locale, "site.feedTitle")}
      href={jsonFeedHref}
    />
    <script
      is:inline
      type="application/ld+json"
      set:html={safeJsonLd(buildGraph({ locale, extraNodes: extraSchemaNodes }))}
    />
    <Analytics domain="artka.dev" gaId="G-X53SL63MK2" />
    <slot name="head" />
    <ClientRouter />
  </head>
  <body>
    <SkipLink />
    <Header />
    <!--
      MobileDrawer is self-contained: it carries its own primary nav and does
      not declare a <slot/> for children, so any nested content is dropped by
      Astro at render time. The drawer is intentionally separate from the
      desktop sidebar to keep mobile navigation editorial-clean.
    -->
    <MobileDrawer />
    <div class="layout" data-full-width={fullWidth} data-no-sidebar={noSidebar}>
      {
        !noSidebar && (
          <aside class="layout__sidebar" aria-label={t(locale, "sidebar.aria")}>
            <slot name="sidebar" />
          </aside>
        )
      }
      <main id="main" class="layout__main">
        <slot />
      </main>
      <aside class="layout__toc" aria-label={t(locale, "post.tocAria")}>
        <slot name="toc" />
      </aside>
    </div>
    <footer class="site-footer">
      <div class="site-footer__inner">
        <nav class="site-footer__cols" aria-label="Footer">
          <section class="site-footer__col">
            <h2 class="site-footer__heading">{t(locale, "footer.section.about")}</h2>
            <ul>
              {
                footerLinks.about.map((l) => (
                  <li>
                    <a href={l.href} data-astro-prefetch={l.prefetch}>
                      {t(locale, l.key)}
                    </a>
                  </li>
                ))
              }
            </ul>
          </section>
          <section class="site-footer__col">
            <h2 class="site-footer__heading">{t(locale, "footer.section.read")}</h2>
            <ul>
              {
                footerLinks.read.map((l) => (
                  <li>
                    <a href={l.href} data-astro-prefetch={l.prefetch}>
                      {t(locale, l.key)}
                    </a>
                  </li>
                ))
              }
            </ul>
          </section>
          <section class="site-footer__col">
            <h2 class="site-footer__heading">{t(locale, "footer.section.connect")}</h2>
            <ul>
              {
                person.sameAs.map((url) => (
                  <li>
                    <a href={url} rel="me noopener" target="_blank">
                      {socialLabel(url)}
                    </a>
                  </li>
                ))
              }
              <li>
                <a href={`mailto:${person.email}`} rel="me">{t(locale, "footer.link.email")}</a>
              </li>
            </ul>
          </section>
        </nav>
      </div>
    </footer>

    <Search />
    <WebMCP />

    <style>
      .layout {
        max-width: var(--content-max);
        margin: 0 auto;
        padding: var(--space-6) var(--space-5);
        display: grid;
        grid-template-columns: var(--col-sidebar) minmax(0, 1fr) var(--col-toc);
        gap: var(--gutter);
      }
      .layout[data-full-width="true"] {
        grid-template-columns: var(--col-sidebar) minmax(0, 1fr);
      }
      .layout[data-full-width="true"] .layout__toc {
        display: none;
      }
      /* noSidebar alone keeps the toc rail (articles); combined with
         fullWidth it collapses to a single centered column. */
      .layout[data-no-sidebar="true"] {
        grid-template-columns: minmax(0, 1fr) var(--col-toc);
      }
      .layout[data-full-width="true"][data-no-sidebar="true"] {
        grid-template-columns: minmax(0, 1fr);
      }
      .layout__sidebar,
      .layout__toc {
        position: sticky;
        top: var(--space-5);
        align-self: start;
        max-height: calc(100vh - var(--space-6));
        overflow-y: auto;
      }
      .layout__main {
        min-width: 0;
      }
      @media (max-width: 1023px) {
        /* data-no-sidebar must be listed explicitly: its desktop rule has
           higher specificity (0,2,0) than bare .layout and would otherwise
           keep the phantom toc track on phones. */
        .layout,
        .layout[data-full-width="true"],
        .layout[data-no-sidebar="true"] {
          grid-template-columns: minmax(0, 1fr);
        }
        .layout__sidebar,
        .layout__toc {
          display: none;
        }
      }
      @media (max-width: 768px) {
        .layout {
          padding: var(--space-4) var(--space-4);
        }
      }
      @media (max-width: 414px) {
        .layout {
          padding: var(--space-3) var(--space-3);
        }
      }

      /* The footer is the page's closing slab: solid ink with paper on top,
         the same inversion the code-block header uses. Both tokens flip with
         the theme, so the block stays legible in paper and in dark without a
         second rule, and it needs no border — it is the edge. */
      .site-footer {
        background: var(--color-fg);
        color: var(--color-bg);
        margin-top: var(--space-8);
      }
      .site-footer__inner {
        max-width: var(--content-max);
        margin: 0 auto;
        padding: var(--space-6) var(--space-5);
        font-size: var(--fs-sm);
      }
      .site-footer__cols {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: var(--space-5);
      }
      .site-footer__col ul {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: var(--space-1);
      }
      /* Footer links are a LABEL list, not running text. Set as body copy
         they read thin and undernourished against the slab they sit on, so
         they take the label treatment the header nav uses: smaller, caps,
         tracked, and heavy enough to hold their own on ink. */
      .site-footer__col li a {
        display: inline-flex;
        align-items: center;
        min-height: 32px;
        overflow-wrap: anywhere;
        font-family: var(--font-mono);
        font-size: var(--fs-xs);
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: var(--tracking-wide);
        color: var(--color-bg);
        /* Resting links sit back from the headings without leaving the
           inverted palette; 78% of paper on ink still clears AA, and caps
           at 12px need slightly more presence than body copy did. */
        opacity: 0.78;
        text-decoration: none;
        /* Reserve the underline up front: a hover must not move the row. */
        border-bottom: var(--stroke-bold) solid transparent;
        transition:
          opacity var(--dur-fast) var(--ease-out),
          border-color var(--dur-fast) var(--ease-out);
      }
      .site-footer__col li a:hover,
      .site-footer__col li a:focus-visible {
        opacity: 1;
        border-bottom-color: var(--color-bg);
      }
      /* The global focus ring is the ultramarine accent, which all but
         disappears on the inverted ground. On this slab the ring is paper. */
      .site-footer :where(a, button):focus-visible {
        outline-color: var(--color-bg);
      }
      .site-footer__heading {
        font-family: var(--font-serif);
        font-size: var(--fs-base);
        text-transform: uppercase;
        letter-spacing: var(--tracking-tight);
        color: var(--color-bg);
        font-weight: 800;
        margin: 0 0 var(--space-4);
      }
      @media (max-width: 767px) {
        .site-footer__inner {
          padding: var(--space-4);
        }
        .site-footer__cols {
          grid-template-columns: repeat(2, minmax(0, 1fr));
          gap: var(--space-4);
        }
        .site-footer__col:last-child {
          grid-column: 1 / -1;
        }
        .site-footer__col:last-child ul {
          flex-direction: row;
          flex-wrap: wrap;
          column-gap: var(--space-4);
        }
      }
    </style>
  </body>
</html>
